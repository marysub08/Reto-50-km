# Copiá este archivo como variables de entorno en Vercel (no lo subas a git con tus datos reales).

# Tus integraciones → tu aplicación → Credenciales de producción → Access Token
MERCADOPAGO_ACCESS_TOKEN=APP_USR-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Tus integraciones → tu aplicación → Webhooks → Clave secreta
MP_WEBHOOK_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# La URL pública donde vas a publicar el sitio (te la da Vercel al desplegar)
SITE_URL=https://tu-proyecto.vercel.app

# Base de datos (Neon Postgres) — para que el progreso de cada alumno no
# dependa de un solo navegador. Se completa sola cuando conectás Neon desde
# Vercel → tu proyecto → Storage → Connect Database → Neon.
DATABASE_URL=postgresql://usuario:password@ep-xxxxx.neon.tech/neondb?sslmode=require

# Clave de la API de Claude (Anthropic) — para el chat de dudas puntuales
# de Mar IA en el plan. La conseguís en console.anthropic.com → API Keys.
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
